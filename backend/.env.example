# Copy to .env. Never commit .env. Run `npm run keys:generate` to fill the key values.
NODE_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=cafe_platform

# Runs migrations. Local dev uses root; production uses cafe_migrator.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=

# Created by `npm run db:grants`. Set your own values, including locally.
DB_MIGRATOR_PASSWORD=
DB_APP_USER=cafe_app
DB_APP_PASSWORD=
DB_REPORTING_PASSWORD=

REDIS_URL=redis://127.0.0.1:6379
CORS_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:8082,http://localhost:8083
PUBLIC_CUSTOMER_APP_URL=http://localhost:8083
PUBLIC_API_URL=http://localhost:3000

# Filled by keys:generate
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
FIELD_ENCRYPTION_KEY=

# Pending configuration: leave blank until real credentials exist.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
GOOGLE_CLIENT_ID=
